generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum Assembly {
  ENGLISH
  LOCAL
}

enum MemberStatus {
  MEMBER
  OFFICER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum LogType {
  LOGIN
  EXPORT_SINGLE
  EXPORT_BULK
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String
  createdAt DateTime   @default(now())
  members   Member[]   @relation("CreatedByUser")
  logs      AuditLog[]
}

model Member {
  id           String    @id @default(cuid())
  title        String?
  firstName    String
  middleName   String?
  lastName     String
  sex          Sex
  dateOfBirth  DateTime?
  placeOfBirth String?

  phone String?
  email String?

  assembly      Assembly
  status        MemberStatus   @default(MEMBER)
  maritalStatus MaritalStatus?

  addressLine1 String?
  gpsAddress   String?
  hometown     String?
  streetName   String?
  city         String?

  holyGhostBaptism            Boolean?
  dateOfHolySpiritBaptism     DateTime?
  waterBaptism                Boolean?
  dateOfBaptism               DateTime?
  dateOfConversion            DateTime?
  dateOfJoining               DateTime?
  placeOfBaptism              String?
  officiatingMinisterBaptism  String?
  officiatingMinisterDistrict String?
  communicant                 Boolean?

  occupation                    String?
  educationLevel                String?
  profile                       String?        @db.Text
  dedicated                     Boolean?
  dedicationDate                DateTime?
  dedicationOfficiatingMinister String?
  dedicationChurch              String?

  photoUrl String?

  createdById String?
  createdBy   User?        @relation("CreatedByUser", fields: [createdById], references: [id])
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([assembly])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       LogType
  targetInfo String?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

model Attendance {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assembly    Assembly
  serviceDate DateTime @db.Date
  checkedInAt DateTime @default(now())

  @@unique([memberId, serviceDate])
  @@index([serviceDate, assembly])
  @@index([checkedInAt])
}
